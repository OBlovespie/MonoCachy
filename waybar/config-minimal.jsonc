{
   "exclusive": "true",
   "layer": "float",
    "position": "top",
    "spacing": 5,

    "margin": 5,
    "width": 2540,
    "height": 49,
    "mod": "dock",
    "margin-top": 10,
    "margin-left": 10,
    "margin-right": 10,
    "reload_style_on_change": true,
    "modules-left":  [
    
            "custom/power",
            "hyprland/workspaces",
            "custom/music" ],


    "modules-right": [
            "pulseaudio",
            "custom/swaync",
	    "clock#time" ],


    "modules-center": [ "" ],
    "hyprland/workspaces": {
         "disable-scroll": false,
         "all-outputs": true,
         "format": "{icon}",
         "format-icons": {
             "1": "I",
             "2": "II",
             "3": "III",
             "4": "IV",
             "5": "V",
             "6": "VI",
             "7": "VII",
             "8": "VIII",
             "9": "IX",
             "10": "X"




         }




    },
    "hyrpland/window": {
        "max-length": 20
    },
    "cpu": {
        "format": "{}% "
    },
    "memory": {
        "format": "{}% 󰍜"

    },
    "temperature": {
             "format": "{}°C"

   },
   "custom/separator": {
    "format": "|",
    "tooltip": false

    },
    "network": {
	"interfaces": ["wlp2s0", "enp6s0"],
        "format-wifi": "  ",
        "format-ethernet": "󰈀",
        "format-disconnected": "!!!"
    },
    "pulseaudio": {
        "format": "{volume} {icon}",
        "format-muted": "",
        "format-icons": ["",""],
        "on-click": ""

   },


              "clock#time": {
              "interval": 1,
              "format": "{:%H:%M}",
              "tooltip": false
},

             "custom/power":{
             "format": "<span font='14' rise='3000'>  </span>",
            "tooltip": false,
            "on-click": "wlogout --buttons-per-row 2"

},


    "custom/swaync": {
    "tooltip": false,
    "on-click": "swaync-client -t -sw",
    "format": "  "


},



  "custom/music": {
    "format": "{}",
    "return-type": "json",
    "exec": "waybar-module-music --whitelist spotify --play-icon '▶' --pause-icon '⏸'" 
}

   }

}
