{
   "exclusive": "true",
   "layer": "float", 
    "position": "top", 
    "spacing": 5,

    "margin": 5,
    "width": 2540,
    "height": 49,
    "mod": "dock",
    "margin-top": 10,
    "margin-left": 10,
    "margin-right": 10,
    "reload_style_on_change": true,
    "modules-left": [ "clock#time", "custom/separator", "pulseaudio", "custom/separator", "network", "custom/separator", "custom/power","custom/separator"],
    "modules-center": ["hyprland/workspaces"],
    "modules-right": [ "custom/separator", "custom/swaync", "custom/separator", "cpu", "custom/separator", "temperature", "custom/separator", "memory", "custom/separator", "clock#date"],

    "hyprland/workspaces": {
         "disable-scroll": false,
         "all-outputs": true,
         "format": "{icon}",
         "format-icons": {
             "1": "I",
             "2": "II",
             "3": "III",
             "4": "IV",
             "5": "V",
             "6": "VI",
             "7": "VII",
             "8": "VIII",
             "9": "IX",
             "10": "X"




         }




    },
    "hyrpland/window": {
        "max-length": 20
    },
    "cpu": {
        "format": "{}% ",
	"tooltip": false
    

    },
    "memory": {
        "format": "{}% 󰍜",
	"tooltip": false

    },
    "temperature": {
             "format": "{}°C",
	     "tooltip": false

   },
   "custom/separator": {
    "format": "|",
    "tooltip": false

    },
    "network": {
	"interfaces": ["wlp2s0", "enp6s0"],   
        "format-wifi": "  ",
        "format-ethernet": "󰈀",
        "format-disconnected": "!!!"
    },
    "pulseaudio": {
        "format": "{volume} {icon}",
        "format-muted": "",
        "format-icons": ["", ""],
        "on-click": ""


    }, "clock#date": {

              "format": "{:%d/%m/%Y %a }",
              "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
              "tooltip": false 
    },
              "clock#time": {
              "interval": 1,
              "format": "{:%H:%M}",
            "tooltip": false
},

             "custom/power":{
             "format": "  ⏻  ",
            "tooltip": false,
            "on-click": "wlogout --buttons-per-row 2"

},


    "custom/swaync": {
    "tooltip": false,
    "on-click": "swaync-client -t -sw",
    "format": "    "


}

    }
}


